#!/usr/bin/env php
<?php
declare(strict_types=1);

// C1 + C2 (adversarial review of d49d97c, both CRITICAL): PHP's CLI SAPI
// defaults display_errors to stdout, and this box has
// zend.exception_ignore_args Off, so an uncaught exception's trace prints
// constructor ARGUMENTS — including the bearer token passed into
// Client::__construct(). This script's entire contract is "stdout is JSON,
// nothing else, diagnostics go to stderr" (see the docblock below); both
// settings must be pinned before anything else runs, not left to whatever
// php.ini happens to be active on the box that cron uses.
ini_set('display_errors', 'stderr');
ini_set('zend.exception_ignore_args', '1');

/**
 * Otack Manager agent CLI.
 *
 * Every command prints JSON on stdout and nothing else, so the skill that
 * drives it never has to parse prose. Diagnostics go to stderr with a
 * non-zero exit code.
 *
 * The lock is NOT taken here — it is held by agent/bin/otack-tick for the
 * whole session (spec §5.1). A lock taken by a short-lived command would be
 * released the moment that command exits.
 */

require_once __DIR__ . '/../lib/Config.php';
require_once __DIR__ . '/../lib/Client.php';
require_once __DIR__ . '/../lib/Triage.php';
require_once __DIR__ . '/../lib/Rank.php';
require_once __DIR__ . '/../lib/Board.php';
require_once __DIR__ . '/../lib/ProjectSetup.php';
require_once __DIR__ . '/../lib/Selection.php';

use App\Agent\{Config, Client, Triage, Rank, Board, ProjectSetup, Selection};

const PHASES = ['researching', 'awaiting_approval', 'implementing', 'review', 'blocked'];

function out(array $data): never {
    echo json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
    exit(0);
}

function fail(string $message, int $code = 1): never {
    fwrite(STDERR, json_encode(['error' => $message], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE) . "\n");
    exit($code);
}

/**
 * A task/project/column id argv entry must be a plain positive integer
 * string. `(int)"5abc"` silently reads as `5` — under `strict_types` that
 * doesn't throw, it just quietly acts on the wrong task, which is worse
 * than refusing outright. `ctype_digit` rejects anything with a sign,
 * decimal point, or trailing garbage before it ever becomes an int.
 */
function positiveIntArg(?string $raw, string $usage): int {
    if ($raw === null || !ctype_digit($raw)) { fail($usage); }
    $n = (int)$raw;
    if ($n <= 0) { fail($usage); }
    return $n;
}

/** Drops "user:pass@" from a scheme URL — repo URLs may carry a token and are echoed back to the chat. */
function redactUrl(?string $url): ?string {
    return $url === null ? null : ProjectSetup::redactUrl($url);
}

/**
 * Refuses (exit 2) free text bound for the server that carries a credential.
 * The bot session may run this CLI with any arguments and any stdin, so
 * `otack comment 5 < ~/.claude/otack-manager/.env` must not post the
 * owner's token to a task thread (Claude's Read deny covers only its own
 * tools, not a shell redirect). The message never echoes the text.
 *
 * @param list<string> $secrets Config::secretValues()
 */
function refuseSecrets(string $text, array $secrets, string $what): void {
    foreach ($secrets as $secret) {
        if ($secret !== '' && str_contains($text, $secret)) {
            fail("$what contains one of this machine's tokens — refusing to send it", 2);
        }
    }
    foreach ([
        '/\botk_[A-Za-z0-9]{8,}/',                              // Otack API token
        '/\b\d{3,20}:[A-Za-z0-9_-]{30,}\b/',                     // Telegram bot token
        '/^\s*(OTACK_[A-Z_]*TOKEN|OTACK_TG_[A-Z_]*)\s*=/m',       // a line of an otack .env
    ] as $pattern) {
        if (preg_match($pattern, $text) === 1) {
            fail("$what looks like it contains a token or an .env line — refusing to send it", 2);
        }
    }
}

function usage(): never {
    fwrite(STDERR, <<<TXT
    otack — Otack Manager CLI (run through the installed wrappers: otack = bot scope, otack-manager = your scope)

      whoami                    verify the token and show the acting user
      projects                  projects visible to this token, with their local entry
      project <id>              repo, branches, instructions, columns
      task <id>                 task, its thread, and its project context
      todo [--project <id>] [--assignee me|any]
                                open tasks, ranked (priority, due date, critical tags, age)
      new-comments <id>         comments written since this user last spoke
      comment <id>              post a comment, body read from stdin (refused if it looks like a token)
      move <id> <column-id>     move the card
      state <id> <phase>        set agent_state (researching|awaiting_approval|implementing|review|blocked)
      assign <id> <me|none|user-id>              (manager scope)
      folder-name <project-id>                   (manager scope) suggested local folder per root
      setup-project <project-id> --root <name> … (manager scope) create the folder + projects.json entry
      next                      the task this tick should work (bot scope)
      tick-note <id> <phase>    record the running tick's task/phase (bot scope)

    TXT);
    exit(2);
}

/** --key value pairs and bare --flags; anything else is a usage error. */
function parseOpts(array $args, array $valued, array $flags = []): array {
    $o = [];
    for ($i = 0; $i < count($args); $i++) {
        $a = (string)$args[$i];
        if (!str_starts_with($a, '--')) { fail("unexpected argument \"$a\"", 2); }
        $k = substr($a, 2);
        if (in_array($k, $flags, true)) { $o[$k] = true; continue; }
        if (!in_array($k, $valued, true)) { fail("unknown option --$k", 2); }
        if (!array_key_exists($i + 1, $args)) { fail("--$k needs a value", 2); }
        $o[$k] = (string)$args[++$i];
    }
    return $o;
}

$argvRest = array_slice($argv, 1);
$cmd = $argvRest[0] ?? '';
if ($cmd === '' || $cmd === '-h' || $cmd === '--help') { usage(); }

$scope = getenv('OTACK_SCOPE');
if (!is_string($scope) || !in_array($scope, Config::SCOPES, true)) {
    fail('OTACK_SCOPE is not set or invalid — run the installed wrapper (~/.claude/otack-agent/bin/otack or otack-manager), not agent/bin/otack directly', 2);
}

try {
    $cfg    = Config::load(getenv('HOME') ?: '', $scope);
    $client = new Client($cfg->instance, $cfg->token);

    $me = null;
    $self = function () use ($client, &$me): array {
        if ($me === null) {
            $r = $client->get('/me');
            if ($r['status'] !== 200) { fail('GET /me returned ' . $r['status']); }
            $json = $r['json'];
            // M3: a `/me` response that isn't an object, or whose `id` is
            // missing/zero/negative, must fail loud right here — not
            // degrade into assignee_id=0 (silent false-idle), not an
            // uncaught InvalidArgumentException out of Triage::newComments,
            // and not an uncaught TypeError from treating `null` as an
            // array downstream.
            if (!is_array($json) || (int)($json['id'] ?? 0) <= 0) {
                fail('GET /me returned an unexpected shape');
            }
            $me = $json;
        }
        return $me;
    };

    // Bot scope: every project the bot touches must be listed locally (spec
    // §7.3) — unchanged. Manager scope: the owner's own token already bounds
    // what is visible (server-side membership); the local entry is returned
    // when there is one and null otherwise (owner decision 2026-10-13).
    $localFor = function (int $projectId) use ($cfg, $scope): ?array {
        $local = $cfg->projectPath($projectId);
        if ($local === null && $scope === 'agent') {
            fail("project $projectId is not listed in ~/.claude/otack-agent/projects.json — refusing to act on it");
        }
        return $local;
    };
    $agentOnly = function (string $cmd) use ($scope): void {
        if ($scope !== 'agent') { fail("\"$cmd\" runs only in the bot's scope (otack-tick)", 2); }
    };
    $managerOnly = function (string $cmd) use ($scope): void {
        if ($scope !== 'manager') { fail("\"$cmd\" runs only in the manager scope (otack-manager)", 2); }
    };

    // Comment counts are needed only for the agent_state values where they
    // decide the outcome (review/awaiting_approval) — one paginated fetch
    // per such task, not per task overall. getAll() (not get()) because a
    // thread past 100 comments would otherwise push the agent's own last
    // comment out of the first page and make the whole thread look unread
    // (spec §4.1, D6).
    $countNewComments = function (int $taskId, int $selfId) use ($client): int {
        $comments = $client->getAll("/tasks/$taskId/comments", ['limit' => 100]);
        return count(Triage::newComments($comments, $selfId));
    };

    switch ($cmd) {
        case 'whoami':
            out($self());

        case 'next': {
            $agentOnly('next');
            $selfId = (int)$self()['id'];

            // getAll(), not get(): GET /tasks caps a page at 100 rows
            // (D6) — an agent assigned more than that would otherwise only
            // ever see its first 100, cursor-stable but silently partial.
            $tasks = $client->getAll('/tasks', ['assignee_id' => $selfId, 'limit' => 100]);

            // Only tasks whose project this machine is allowed to touch
            // (spec §7.3) — existing behaviour, kept.
            $tasks = array_values(array_filter(
                $tasks,
                fn($t) => $cfg->projectPath((int)$t['project_id']) !== null
            ));

            // GET /tasks has no column filter (TaskRepository::listAssignedAfterId)
            // — it returns Done and Backlog cards too, all with
            // agent_state: null, which Triage::pick would read as "new".
            // Drop anything not sitting in a workable column: neither the
            // done column nor the backlog (ProjectsHandler::serializeOne()
            // emits is_done/is_backlog per column). Fetched once per
            // distinct project id, not once per task.
            //
            // M1: a failed or malformed GET /projects/{id} here used to
            // degrade to an empty workable-column set — fail-closed on
            // *picking* is right, but the result then reads identically to
            // "no work to do" (reason: idle, exit 0), so a broken project
            // makes the bot go permanently and silently dormant. Fail loud
            // instead, the same way the comment-fetch path already does.
            $workableColumns = [];
            foreach (array_unique(array_map(fn($t) => (int)$t['project_id'], $tasks)) as $pid) {
                $p = $client->get("/projects/$pid");
                if ($p['status'] !== 200) {
                    fail("GET /projects/$pid returned " . $p['status']);
                }
                $columns = $p['json']['columns'] ?? null;
                if (!is_array($columns)) {
                    fail("GET /projects/$pid: response is missing a 'columns' array");
                }
                $ids = [];
                foreach ($columns as $c) {
                    if (empty($c['is_done']) && empty($c['is_backlog'])) { $ids[] = (int)$c['id']; }
                }
                $workableColumns[$pid] = $ids;
            }
            $tasks = array_values(array_filter(
                $tasks,
                fn($t) => in_array((int)$t['column_id'], $workableColumns[(int)$t['project_id']] ?? [], true)
            ));

            $counts = [];
            foreach ($tasks as $t) {
                if (in_array($t['agent_state'] ?? null, ['review', 'awaiting_approval'], true)) {
                    $counts[(int)$t['id']] = $countNewComments((int)$t['id'], $selfId);
                }
            }

            // Telegram selection mode (owner decision 2026-10-13): a task
            // nobody has started is eligible only after the owner tapped it.
            // Fail-closed: an unreadable selection.json, or the marker
            // otack-tick leaves after a failed approval pass, approves
            // nothing — work the bot already has is unaffected.
            $approvedNew = null;
            if ($cfg->approval['mode'] === 'telegram') {
                $agentDir = dirname($cfg->projectsFile);
                try {
                    $approvedNew = Selection::load($agentDir . '/selection.json')['approved'];
                } catch (\RuntimeException $e) {
                    fwrite(STDERR, 'telegram selection unreadable, starting no new task: ' . $e->getMessage() . "\n");
                    $approvedNew = [];
                }
                if ($approvedNew !== [] && file_exists($agentDir . '/approval-closed')) {
                    fwrite(STDERR, "the last approval pass failed (approval-closed) — starting no new task this tick\n");
                    $approvedNew = [];
                }
            }

            // Triage::pick()'s from_form check is a second line of defence,
            // not the only one (Task 3's docblock explains why): these
            // $tasks came from GET /tasks list items, which never carry
            // from_form at all, so pick() has nothing to filter on here.
            // Verify the actual winner against the DETAIL shape before
            // acting on it, and re-triage the remaining pool if it turns
            // out to be a form-created task, OR — same reasoning — if it
            // turns out to already be `blocked` (a race: the list item was
            // fetched before a human blocked it moments later; pick()
            // already filtered on the list's own agent_state, so this is
            // the DETAIL payload catching what the list snapshot couldn't).
            // Bounded at 10 rounds so a pathological pool (e.g. every
            // remaining task form-created) cannot loop forever.
            $pool = $tasks;
            for ($round = 0; $round < 10; $round++) {
                $picked = Triage::pick($pool, $counts, $approvedNew);
                if ($picked === null) {
                    $waiting = $approvedNew !== null && array_filter($pool, fn($t) =>
                        ($t['agent_state'] ?? null) === null && !in_array((int)$t['id'], $approvedNew, true)) !== [];
                    out(['task' => null, 'reason' => $waiting ? 'awaiting_owner_selection' : 'idle']);
                }

                $winnerId = (int)$picked['task']['id'];
                $detail = $client->get("/tasks/$winnerId");
                if ($detail['status'] !== 200) {
                    fail("GET /tasks/$winnerId returned " . $detail['status']);
                }

                $isFormCreated = !empty($detail['json']['from_form']);
                $isBlocked     = ($detail['json']['agent_state'] ?? null) === 'blocked';
                if ($isFormCreated || $isBlocked) {
                    $pool = array_values(array_filter($pool, fn($t) => (int)$t['id'] !== $winnerId));
                    continue;
                }

                // The DETAIL payload is strictly richer than the list item
                // pick() worked from (it has description, tags, links,
                // comments_count, from_form) — return it instead of the
                // list-item shape so the caller never has to make a second
                // round trip just to get what it already fetched here.
                // Same for `local`: the skill needs the checkout path
                // before it can touch the repo at all, and Config already
                // has it in hand from the project-path filter above — hand
                // it over instead of making the caller run `otack project`
                // just to ask a second time.
                $projectId = (int)$detail['json']['project_id'];
                out([
                    'task'   => $detail['json'],
                    'reason' => $picked['reason'],
                    'local'  => $cfg->projectPath($projectId),
                ]);
            }

            // Every candidate in 10 straight rounds turned out to be
            // form-created or newly-blocked at the DETAIL stage. That is
            // NOT the same situation as an empty pool (genuinely no work):
            // real work may be sitting right behind the form tasks. Use a
            // distinct reason so it doesn't read to the operator as "idle".
            out(['task' => null, 'reason' => 'idle_form_bound_exceeded']);
        }

        case 'task': {
            $id = positiveIntArg($argvRest[1] ?? null, 'usage: otack task <id>');
            $t = $client->get("/tasks/$id");
            if ($t['status'] !== 200) { fail("GET /tasks/$id returned " . $t['status']); }
            $projectId = (int)$t['json']['project_id'];
            $local = $localFor($projectId);
            $p = $client->get("/projects/$projectId");
            $comments = $client->getAll("/tasks/$id/comments", ['limit' => 100]);
            out([
                'task'     => $t['json'],
                'project'  => $p['json'],
                'local'    => $local,
                'comments' => $comments,
                'new_comments' => Triage::newComments($comments, (int)$self()['id']),
            ]);
        }

        case 'project': {
            $id = positiveIntArg($argvRest[1] ?? null, 'usage: otack project <id>');
            $local = $localFor($id);
            $p = $client->get("/projects/$id");
            if ($p['status'] !== 200) { fail("GET /projects/$id returned " . $p['status']); }
            out(['project' => $p['json'], 'local' => $local]);
        }

        case 'new-comments': {
            $id = positiveIntArg($argvRest[1] ?? null, 'usage: otack new-comments <id>');
            // C3: this command used to skip the allow-list gate entirely —
            // fetch the task first (purely to learn its project_id) and
            // refuse before touching the comment thread at all if this
            // machine isn't allowed to act on that project (spec §7.3).
            $t = $client->get("/tasks/$id");
            if ($t['status'] !== 200) { fail("GET /tasks/$id returned " . $t['status']); }
            $localFor((int)$t['json']['project_id']);
            $comments = $client->getAll("/tasks/$id/comments", ['limit' => 100]);
            out(['items' => Triage::newComments($comments, (int)$self()['id'])]);
        }

        case 'state': {
            $id    = positiveIntArg($argvRest[1] ?? null, 'usage: otack state <id> <phase>');
            $phase = (string)($argvRest[2] ?? '');
            if (!in_array($phase, PHASES, true)) {
                fail('unknown phase "' . $phase . '" — valid: ' . implode('|', PHASES));
            }
            // C3: gate before writing. Same fetch-then-check shape as
            // new-comments above.
            $t = $client->get("/tasks/$id");
            if ($t['status'] !== 200) { fail("GET /tasks/$id returned " . $t['status']); }
            $localFor((int)$t['json']['project_id']);
            $r = $client->patch("/tasks/$id", ['agent_state' => $phase]);
            if ($r['status'] !== 200) { fail("PATCH /tasks/$id returned " . $r['status']); }
            out($r['json']);
        }

        case 'move': {
            $id     = positiveIntArg($argvRest[1] ?? null, 'usage: otack move <id> <column-id>');
            $column = positiveIntArg($argvRest[2] ?? null, 'usage: otack move <id> <column-id>');

            // TaskRepository::move() writes `position` exactly as given, so
            // a flat constant (the old `1024` here) collides every
            // agent-moved card at the same spot the moment a second one
            // lands in a column that already has one (D10). Ask the
            // project for the target column's current cards and append
            // past the highest position in it — same ordering the web UI's
            // drag-and-drop already relies on. `column_id` filters
            // server-side so this stays one small paginated fetch, not the
            // whole project board.
            $t = $client->get("/tasks/$id");
            if ($t['status'] !== 200) { fail("GET /tasks/$id returned " . $t['status']); }
            $projectId = (int)$t['json']['project_id'];
            // C3: this fetch already happens for the position maths below —
            // the project_id is in hand, so the allow-list gate costs
            // nothing extra to add here.
            $localFor($projectId);
            $inColumn = $client->getAll("/projects/$projectId/tasks", ['column_id' => $column, 'limit' => 100]);
            $position = Triage::nextPosition($inColumn);

            $r = $client->post("/tasks/$id/move", ['column_id' => $column, 'position' => $position]);
            if ($r['status'] !== 200) { fail("POST /tasks/$id/move returned " . $r['status']); }
            out($r['json']);
        }

        case 'comment': {
            $id = positiveIntArg($argvRest[1] ?? null, 'usage: otack comment <id>  (body on stdin)');
            // The body is checked before any request: a refused body costs
            // no round trip and reveals nothing to the server.
            $body = stream_get_contents(STDIN);
            if ($body === false) { $body = ''; }
            if (trim($body) === '') { fail('refusing to post an empty comment'); }
            // M2: the agent pipes git diffs and file excerpts into this
            // command, so a stray latin-1 or binary byte is expected input,
            // not a bug upstream. json_encode() returns false on invalid
            // UTF-8, which would then hand `false` to Client::post()'s
            // `?string $body` parameter and blow up as a strict_types
            // TypeError deep inside the client instead of a clean refusal
            // here.
            if (!mb_check_encoding($body, 'UTF-8')) {
                fail('comment body is not valid UTF-8 — refusing to post it');
            }
            refuseSecrets($body, $cfg->secretValues(), 'comment body');

            // C3: gate before writing.
            $t = $client->get("/tasks/$id");
            if ($t['status'] !== 200) { fail("GET /tasks/$id returned " . $t['status']); }
            $localFor((int)$t['json']['project_id']);
            $r = $client->post('/comments', ['entity' => 'task', 'entity_id' => $id, 'body' => $body]);
            if ($r['status'] !== 201) { fail('POST /comments returned ' . $r['status']); }
            out($r['json']);
        }

        case 'tick-note': {
            $agentOnly('tick-note');
            // Rewrites agent.lock with which task/phase the running tick is
            // on, so the *next* tick — if this one wedges — can say
            // something useful instead of a bare "still running" (spec
            // §5.1, D7). The lock's mutual exclusion is `flock`, held by
            // otack-tick for the session's whole lifetime (Task 5); this
            // command only edits the JSON payload inside that same file, it
            // does not take or need the lock itself — there is only ever
            // one live session to race against, and that session is the one
            // calling this command. (Taking a fresh flock() here would
            // deadlock against the parent otack-tick process, which already
            // holds LOCK_EX on this exact file for the whole session.)
            $id    = positiveIntArg($argvRest[1] ?? null, 'usage: otack tick-note <id> <phase>');
            $phase = (string)($argvRest[2] ?? '');
            if ($phase === '') { fail('usage: otack tick-note <id> <phase>'); }
            if (!in_array($phase, PHASES, true)) {
                fail('unknown phase "' . $phase . '" — valid: ' . implode('|', PHASES));
            }
            // M3 (adversarial review of 8144dfe): this command used to
            // validate only that <id> is a positive integer — every other
            // write here gates on the allow-list ($localFor, since b4a4c4f),
            // but tick-note took the id at face value and rewrote
            // agent.lock's task_id/phase for a task in a project this
            // machine isn't even allowed to touch. Same fetch-then-check
            // shape as `state`/`comment`/`move` above.
            $t = $client->get("/tasks/$id");
            if ($t['status'] !== 200) { fail("GET /tasks/$id returned " . $t['status']); }
            $localFor((int)$t['json']['project_id']);
            $lockPath = rtrim(getenv('HOME') ?: '', '/') . '/.claude/otack-agent/agent.lock';
            if (!is_file($lockPath)) {
                fail("no agent.lock at $lockPath — tick-note must run inside an otack-tick session");
            }
            $info = json_decode((string)file_get_contents($lockPath), true);
            if (!is_array($info)) {
                fail("$lockPath is not valid JSON");
            }
            $info['task_id'] = $id;
            $info['phase']   = $phase;
            $encoded = json_encode($info, JSON_PRETTY_PRINT);
            if ($encoded === false) {
                fail('failed to encode agent.lock payload as JSON: ' . json_last_error_msg());
            }
            if (file_put_contents($lockPath, $encoded) === false) {
                fail("failed to write $lockPath");
            }
            out(['task_id' => $id, 'phase' => $phase]);
        }

        case 'projects': {
            $items = $client->getAll('/projects', ['limit' => 100]);
            // Bot scope sees only what projects.json lists — same boundary
            // as every other command; the owner's scope sees everything its
            // token can, with `local` null for unlisted projects.
            if ($scope === 'agent') {
                $items = array_values(array_filter($items, fn($p) => $cfg->projectPath((int)$p['id']) !== null));
            }
            out(['items' => array_map(fn($p) => [
                'id'             => (int)$p['id'],
                'name'           => (string)($p['name'] ?? ''),
                'slug'           => $p['slug'] ?? null,
                'status'         => $p['status'] ?? null,
                'repo_url'       => $p['repo_url'] ?? null,
                'default_branch' => $p['default_branch'] ?? null,
                'local'          => $cfg->projectPath((int)$p['id']),
            ], $items)]);
        }

        case 'todo': {
            $usageTodo = 'usage: otack todo [--project <id>] [--assignee me|any]';
            $o = parseOpts(array_slice($argvRest, 1), ['project', 'assignee']);
            // Validate before any network call: a bad value must not cost a
            // round trip (or a project fetch) first.
            if (isset($o['assignee']) && !in_array($o['assignee'], ['me', 'any'], true)) { fail($usageTodo, 2); }
            if (isset($o['project']) && (!ctype_digit($o['project']) || (int)$o['project'] <= 0)) { fail($usageTodo, 2); }
            $selfId = (int)$self()['id'];
            $byProject = [];
            $projects = [];
            if (isset($o['project'])) {
                $pid = positiveIntArg($o['project'], $usageTodo);
                $localFor($pid);
                $assignee = $o['assignee'] ?? 'any';
                $projects[$pid] = Board::project($client, $pid);
                $byProject[$pid] = Board::openTasks($client, $projects[$pid]);
            } else {
                $assignee = $o['assignee'] ?? 'me';
                if ($assignee !== 'me') { fail('without --project, todo lists only your own tasks (--assignee me)', 2); }
                foreach ($client->getAll('/tasks', ['assignee_id' => $selfId, 'limit' => 100]) as $t) {
                    $byProject[(int)$t['project_id']][] = $t;
                }
                foreach (array_keys($byProject) as $pid) {
                    if ($scope === 'agent' && $cfg->projectPath($pid) === null) { unset($byProject[$pid]); continue; }
                    $projects[$pid] = Board::project($client, $pid);
                    $cols = Board::workableColumnIds($projects[$pid]);
                    $byProject[$pid] = array_values(array_filter($byProject[$pid], fn($t) => in_array((int)$t['column_id'], $cols, true)));
                }
            }

            $now = new \DateTimeImmutable('now');
            $items = [];
            foreach ($byProject as $pid => $rows) {
                if ($assignee === 'me') {
                    $rows = array_values(array_filter($rows, fn($t) => (int)($t['assignee_id'] ?? 0) === $selfId));
                }
                if ($rows === []) { continue; }
                $critical = Board::criticalTaskIds($client, $pid, $cfg->approval['critical_tags']);
                foreach (Rank::sort($rows, $critical, $now) as $t) {
                    $rank = $t['rank'];
                    unset($t['rank']);
                    $items[] = [
                        'task'    => $t,
                        'project' => ['id' => $pid, 'name' => (string)($projects[$pid]['name'] ?? '')],
                        'rank'    => $rank,
                        'local'   => $cfg->projectPath($pid) !== null,
                    ];
                }
            }
            usort($items, fn($a, $b) => [$b['rank']['score'], (int)$a['task']['id']] <=> [$a['rank']['score'], (int)$b['task']['id']]);
            out(['items' => $items, 'count' => count($items)]);
        }

        case 'assign': {
            $managerOnly('assign');
            $usageAssign = 'usage: otack assign <id> <me|none|user-id>';
            $id  = positiveIntArg($argvRest[1] ?? null, $usageAssign);
            $who = (string)($argvRest[2] ?? '');
            if ($who === 'me') {
                $assigneeId = (int)$self()['id'];
            } elseif ($who === 'none') {
                $assigneeId = null;
            } elseif (ctype_digit($who) && (int)$who > 0) {
                $assigneeId = (int)$who;
            } else {
                fail($usageAssign, 2);
            }
            $t = $client->get("/tasks/$id");
            if ($t['status'] !== 200) { fail("GET /tasks/$id returned " . $t['status']); }
            $localFor((int)$t['json']['project_id']);
            $r = $client->patch("/tasks/$id", ['assignee_id' => $assigneeId]);
            if ($r['status'] !== 200) { fail("PATCH /tasks/$id returned " . $r['status']); }
            out($r['json']);
        }

        case 'folder-name': {
            $managerOnly('folder-name');
            $pid = positiveIntArg($argvRest[1] ?? null, 'usage: otack folder-name <project-id>');
            $project = Board::project($client, $pid);
            $folder = ProjectSetup::folderName($project);
            $repoUrl = is_string($project['repo_url'] ?? null) && $project['repo_url'] !== '' ? $project['repo_url'] : null;
            $candidates = [];
            foreach ($cfg->roots as $key => $root) {
                $path = $root . '/' . $folder;
                $origin = is_dir($path) && !is_link($path) ? ProjectSetup::originOf($path) : null;
                $candidates[] = [
                    'root'      => $key,
                    'path'      => $path,
                    'exists'    => file_exists($path) || is_link($path),
                    'origin'    => redactUrl($origin),
                    'same_repo' => $origin !== null && $repoUrl !== null ? ProjectSetup::sameRepo($origin, $repoUrl) : null,
                ];
            }
            out([
                'project' => [
                    'id' => $pid, 'name' => $project['name'] ?? '', 'slug' => $project['slug'] ?? null,
                    'repo_url' => redactUrl($repoUrl), 'default_branch' => $project['default_branch'] ?? null,
                ],
                'folder'     => $folder,
                'roots'      => $cfg->roots === [] ? new \stdClass() : $cfg->roots,
                'candidates' => $candidates,
                'local'      => $cfg->projectPath($pid),
                'columns'    => array_map(fn($c) => ['id' => (int)$c['id'], 'name' => (string)$c['name']], $project['columns']),
            ]);
        }

        case 'setup-project': {
            $managerOnly('setup-project');
            $usageSetup = 'usage: otack setup-project <project-id> --root <name> [--folder <name>] [--write] [--clone] '
                . '[--test-cmd <cmd>] [--in-progress <column>] [--review <column>] [--default-branch <branch>] [--replace]';
            $pid = positiveIntArg($argvRest[1] ?? null, $usageSetup);
            $o = parseOpts(array_slice($argvRest, 2),
                ['root', 'folder', 'test-cmd', 'in-progress', 'review', 'default-branch'],
                ['write', 'clone', 'replace']);
            if (!isset($o['root'])) { fail($usageSetup, 2); }

            // 1. Validate everything before creating anything.
            $root = $cfg->roots[$o['root']] ?? null;
            if ($root === null) {
                fail('unknown root "' . $o['root'] . '" — configured: '
                    . ($cfg->roots === [] ? '(none — add "roots" to projects.json)' : implode(', ', array_keys($cfg->roots))));
            }
            if ($cfg->projectPath($pid) !== null && empty($o['replace'])) {
                fail("project $pid is already in projects.json — pass --replace to overwrite its entry");
            }
            $project = Board::project($client, $pid);
            $folder = $o['folder'] ?? ProjectSetup::folderName($project);
            if (!preg_match(ProjectSetup::FOLDER_PATTERN, $folder)) {
                fail("folder name \"$folder\" must match [a-z0-9][a-z0-9._-]* (lowercase, no slashes)");
            }
            $path = $root . '/' . $folder;
            if (!preg_match(ProjectSetup::RULE_SAFE_PATH, $path)) {
                fail("$path contains characters the bot's permission rules cannot carry — choose a root/folder made of [A-Za-z0-9_./-]");
            }
            if (isset($o['test-cmd']) && $o['test-cmd'] !== '' && !preg_match(Config::TEST_CMD_PATTERN, $o['test-cmd'])) {
                fail('test_cmd may contain only [A-Za-z0-9 _./-] (a ")" or ":" would inject permission rules)');
            }
            $columns = $project['columns'];
            $colRef = function (?string $v) use ($columns): int|string|null {
                if ($v === null) { return null; }
                foreach ($columns as $c) {
                    if (ctype_digit($v) && (int)$c['id'] === (int)$v) { return (int)$v; }
                    if ((string)$c['name'] === $v) { return $v; }
                }
                fail("no column \"$v\" on this board — existing: "
                    . implode(', ', array_map(fn($c) => $c['id'] . ' "' . $c['name'] . '"', $columns)));
            };
            $entry = ['path' => $path, 'write' => !empty($o['write'])];
            if (isset($o['test-cmd']) && $o['test-cmd'] !== '') { $entry['test_cmd'] = $o['test-cmd']; }
            $inProgress = $colRef($o['in-progress'] ?? null);
            if ($inProgress !== null) { $entry['in_progress_column'] = $inProgress; }
            $review = $colRef($o['review'] ?? null);
            if ($review !== null) { $entry['review_column'] = $review; }
            // Same rule as otack-tick: a branch it rejects would stop the tick for every project.
            $branch = $o['default-branch'] ?? ($project['default_branch'] ?? null);
            if (is_string($branch) && $branch !== '') {
                if (strlen($branch) > 100 || !Config::isSafeBranchName($branch)) {
                    fail("invalid default branch \"$branch\" (letters, digits, . _ / -; starts with a letter or digit; no \"..\")"
                        . (isset($o['default-branch']) ? '' : ' — it comes from the server; pass --default-branch'));
                }
                $entry['default_branch'] = $branch;
            }
            $repoUrl = is_string($project['repo_url'] ?? null) && $project['repo_url'] !== '' ? $project['repo_url'] : null;
            $wantClone = !empty($o['clone']);
            if ($wantClone && $repoUrl === null) {
                fail("project $pid has no repo_url — fill it in Otack Manager or drop --clone");
            }

            // 2. Inspect what is already on disk.
            $created = false;
            $cloned = false;
            $madeByRun = false;    // $path did not exist before this run — rollback removes it
            $wasEmptyDir = false;  // $path was an empty folder we clone into — rollback empties it again
            // Leave the disk as it was found: only what this run made goes.
            $rollback = function (\Throwable $e) use (&$madeByRun, &$wasEmptyDir, $path): never {
                if ($madeByRun || $wasEmptyDir) { ProjectSetup::removeTree($path, $wasEmptyDir); }
                throw $e;
            };
            if (is_link($path)) { fail("$path is a symlink — refusing"); }
            if (file_exists($path)) {
                if (!is_dir($path)) { fail("$path exists and is not a directory"); }
                $origin = ProjectSetup::originOf($path);
                if ($origin !== null && $repoUrl !== null && !ProjectSetup::sameRepo($origin, $repoUrl)) {
                    fail("$path is a checkout of " . redactUrl($origin) . ", not of this project's repo_url "
                        . redactUrl($repoUrl) . ' — choose another --folder');
                }
                if ($wantClone && $origin === null) {
                    if (file_exists($path . '/.git')) {
                        fail("$path is a git checkout without an \"origin\" remote — add origin there or choose another --folder");
                    }
                    if (count(scandir($path) ?: []) > 2) {
                        fail("$path exists, is not empty and is not a git checkout — refusing to clone into it");
                    }
                    $wasEmptyDir = true;
                }
            } else {
                // mkdir() first, atomically: if anything appeared at $path since the
                // checks above it fails, and from here on every byte under $path is ours.
                if (!@mkdir($path, 0755)) { fail("cannot create $path"); }
                $madeByRun = true;
                $created = !$wantClone;
            }
            if ($wantClone && ($madeByRun || $wasEmptyDir)) {
                try {
                    ProjectSetup::cloneInto($repoUrl, $path);   // git clones into an existing empty folder
                } catch (\Throwable $e) {
                    $rollback($e);
                }
                $cloned = true;
            }

            // 3. Write the entry (validated again by Config with load()'s rules).
            try {
                $parsed = $cfg->writeProjectEntry($pid, $entry);
            } catch (\Throwable $e) {
                $rollback($e);
            }
            out(['project_id' => $pid, 'entry' => $parsed, 'created_folder' => $created, 'cloned' => $cloned]);
        }

        default:
            fail("unknown command \"$cmd\" — run otack --help", 2);
    }
} catch (\Throwable $e) {
    // C1: was `catch (\RuntimeException $e)`, which is not a parent of
    // Client's `\InvalidArgumentException` (thrown on a non-https,
    // non-loopback base URL — e.g. a single missing "s" in OTACK_API_URL)
    // nor of a stray \TypeError. Either escaped uncaught, and PHP's default
    // handler prints a trace WITH ARGUMENT VALUES when
    // zend.exception_ignore_args is Off — putting the bearer token on
    // stdout, stderr, and in cron's mail. Exception *messages* below never
    // contain the token (only the trace's argument dump would have), so
    // widening the catch to Throwable is safe: fail() only ever emits
    // $e->getMessage().
    fail($e->getMessage());
}
